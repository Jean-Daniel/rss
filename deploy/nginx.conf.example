# nginx server block for Fever v2, proxying to the container published on
# 127.0.0.1:3000 (see fever-v2.container). Adapt server_name and certificates.
#
# If nginx itself runs as a container on the same podman network, use
# `proxy_pass http://fever-v2:8080;` instead and drop PublishPort.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name rss.example.com;

    ssl_certificate     /etc/letsencrypt/live/rss.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rss.example.com/privkey.pem;

    # OPML imports are small; nothing else uploads.
    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The app reads the last address of this header as the client IP
        # (for login rate limiting) when TRUST_PROXY=true.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # Compress API responses. Static files already arrive compressed from
    # the app (nginx leaves responses with a Content-Encoding alone).
    gzip on;
    gzip_proxied any;
    gzip_vary on;
    gzip_min_length 512;
    gzip_types application/json application/manifest+json;
}

server {
    listen 80;
    listen [::]:80;
    server_name rss.example.com;
    return 301 https://$host$request_uri;
}
